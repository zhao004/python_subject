# 网站标题配置（浏览器标签页标题，由 vite.config.js 注入到 index.html）
SITE_TITLE=题库配对检测系统

# 后台管理侧边栏顶部标题文案（展开时显示图标+标题，收缩时仅显示图标）
ADMIN_SIDEBAR_TITLE=后台管理123

# 后台管理员凭据和会话配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ADMIN_COOKIE_SECURE=false
IP2REGION_XDB_PATH=

# Database configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=quiz_db
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
